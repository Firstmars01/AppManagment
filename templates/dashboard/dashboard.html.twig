{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    {# Projects Section #}
    <div class="container mt-5">
        <div class="table-responsive">
            <h2>My Project</h2>
            {% if projects is empty %}
                <p>No data</p>
            {% else %}
                <table class="table table-hover">
                    {% include 'components/organisms/molecule/project_head.html.twig' %}
                    {% include 'components/organisms/molecule/project_body.html.twig' with {'projects': projects} %}
                </table>
            {% endif %}
        </div>
    </div>

    {# Tasks Section #}
    <div class="container mt-5">
        <div class="table-responsive">
            <h2>My tasks</h2>
            {% if tasks is empty %}
                <p>No data</p>
            {% else %}
                <table class="table table-hover">
                    {% include 'components/organisms/molecule/tasks_head_dashboard.html.twig' %}
                    {% include 'components/organisms/molecule/tasks_body_dashboard.html.twig' with {'tasks': tasks} %}
                </table>
            {% endif %}
        </div>
    </div>

    {# Milestones Section #}
    <div class="container mt-5">
        <div class="table-responsive">
            <h2>My milestones</h2>
            {% if milestones is empty %}
                <p>No data</p>
            {% else %}
                <table class="table table-hover">
                    {% include 'components/organisms/molecule/milestones_head_dashboard.html.twig' %}
                    {% include 'components/organisms/molecule/milestones_body_dashboard.html.twig' with {'milestones': milestones} %}
                </table>
            {% endif %}
        </div>
    </div>


{% endblock %}

