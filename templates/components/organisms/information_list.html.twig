<!-- General Information -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">{{ 'project.general_info' | trans }}</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>{{ 'project.owner' | trans }}:</strong> {{ project.owner.name }} {{ project.owner.secondName }}</p>
                <p><strong>{{ 'project.email' | trans }}:</strong> {{ project.owner.email }}</p>
                <p><strong>{{ 'project.created_on' | trans }}:</strong> {{ project.createdAt|date('d/m/Y') }}</p>
                <p><strong>{{ 'project.last_updated' | trans }}:</strong> {{ project.updatedAt|date('d/m/Y') }}</p>
                {% if app.user %}
                    <td>
                        <a href="{{ path('app_crud_project_edit', {'id': project.id}) }}">{{ 'project.edit' | trans }}</a>
                    </td>
                    <td>
                        {{ include('crud_project/_delete_form.html.twig', { project: project }) }}
                    </td>
                {% endif %}
            </div>
        </div>
    </div>
</div>
