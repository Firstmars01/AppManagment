<!-- General Information -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">General Information</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Owner:</strong> {{ project.owner.name }} {{ project.owner.secondName }}</p>
                <p><strong>Email:</strong> {{ project.owner.email }}</p>
                <p><strong>Created on:</strong> {{ project.createdAt|date('d/m/Y') }}</p>
                <p><strong>Last updated:</strong> {{ project.updatedAt|date('d/m/Y') }}</p>
                {% if app.user %}
                    <td>
                        <a href="{{ path('app_crud_project_edit', {'id': project.id}) }}">edit</a>
                    </td>
                    <td>
                        {{ include('crud_project/_delete_form.html.twig', { project: project }) }}
                    </td>
                {% endif %}
            </div>
        </div>
    </div>
</div>