            <a class="btn btn-outline-danger" href="{{ path('app_dashboard') }}">{{ 'my_project' | trans }}</a>
        {% endif %}
    </div>
    <div>
        <li class="nav-item dropdown">
                <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdown-language">
                    <li><a class="dropdown-item" href="{{ path('project_list', {_locale: 'en'}) }}">English</a></li>
                    <li><a class="dropdown-item" href="{{ path('project_list', {_locale: 'fr'}) }}">Français</a></li>
                </ul>
        </li>
