<nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
    <div class="container-fluid">
        <div class="collapse navbar-collapse" id="navbarNav">
            {% if app.user %}
                <span class="navbar-text me-3">{{ 'welcome' | trans }} {{ app.user.userIdentifier }}</span>
                <a class="btn btn-outline-danger" href="{{ path('app_logout') }}">{{ 'logout' | trans }}</a>
            {% else %}
                <a class="btn btn-outline-primary" href="{{ path('app_login') }}">{{ 'login' | trans }}</a>
            {% endif %}
        </div>
    </div>

    <div>
        <a class="btn btn-outline-secondary" href="{{ path('project_list') }}">{{ 'home' | trans }}</a>
