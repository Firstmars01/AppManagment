<tbody>
{% for milestone in milestones %}
    <tr>
        <td>{{ milestone.project.name }}</td>
        <td>
            <a href="{{ path('app_milestone', { slug: milestone.project.slug, id: milestone.id }) }}">
                {{ milestone.label }}
            </a>
        </td>
        <td>
            {% if milestone.plannedStartDate %}
                {{ milestone.plannedStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            {% if milestone.actualStartDate %}
                {{ milestone.actualStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            <span class="badge bg-secondary">{{ milestone.tasks|length }} tasks</span>
        </td>
        <td>
            <a href="{{ path('app_crud_milestone_edit', {'id': milestone.id}) }}">edit</a>
        </td>
        <td>
            {{ include('crud_milestone/_delete_form.html.twig') }}
        </td>
    </tr>
{% endfor %}
</tbody>