<tbody>
{% for task in project.tasks %}
    <tr>
        <td>
            {% if task.milestone %}
                <a href="{{ path('app_task', { slug: task.milestone.project.slug, id: task.id }) }}">
                    {{ task.label }}
                </a>
            {% else %}
                {{ task.label }}
            {% endif %}
        </td>
        <td>{{ task.description }}</td>
        <td>
            {% if task.requirements is empty %}
                <span class="text-muted">{{ 'task.none' | trans }}</span>
            {% else %}
                {% set requirementIndexMap = {} %}
                {% for projectReq in project.requirements %}
                    {% set requirementIndexMap = requirementIndexMap|merge({(projectReq.id.toRfc4122): loop.index}) %}
                {% endfor %}

                {% for req in task.requirements %}
                    {% set reqNumber = requirementIndexMap[req.id.toRfc4122] ?? '?' %}
                    <span class="badge bg-info me-1" title="{{ req.description }}" data-bs-toggle="tooltip">#{{ reqNumber }}</span>
                {% endfor %}
            {% endif %}
        </td>
        <td>{{ task.milestone.label }}</td>
        <td>{{ task.manager.name }} {{ task.manager.secondName }}</td>
        <td>
            {% if task.isFunctional %}
                <span class="badge bg-success">{{ 'task.functional' | trans }}</span>
            {% else %}
                <span class="badge bg-warning">{{ 'task.no_functional' | trans }}</span>
            {% endif %}
        </td>
        <td>
            {% if task.plannedStartDate %}
                {{ task.plannedStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            {% if task.actualStartDate %}
                {{ task.actualStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            {% if task.daysEstimate %}
                {{ task.daysEstimate }} {{ 'task.days_estimate' | trans }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            {% if task.IsFunctional %}
                <span class="badge bg-success">{{ 'task.yes' | trans }}</span>
            {% else %}
                <span class="badge bg-danger">{{ 'task.no' | trans }}</span>
            {% endif %}
        </td>
        <td>
            {% if task.previousTask %}
                {{ task.previousTask.label }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        {% if app.user %}
        <td>
            <a href="{{ path('app_crud_task_edit', {'id': task.id}) }}">{{ 'task.edit' | trans }}</a>
        </td>
        <td>
            {{ include('crud_task/_delete_form.html.twig') }}
        </td>
        {% endif %}
    </tr>
{% endfor %}
</tbody>
