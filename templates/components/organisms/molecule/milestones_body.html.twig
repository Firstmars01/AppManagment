<tbody>
{% for milestone in project.milestones %}
    <tr>
        <td>
            <a href="{{ path('app_milestone', { slug: project.slug, id: milestone.id }) }}">
                {{ milestone.label }}
            </a>
        </td>
        <td>
            {% if milestone.manager %}
                {{ milestone.manager.name }} {{ milestone.manager.secondName }}
            {% else %}
                <span class="text-muted">{{ 'milestone.unassigned' | trans }}</span>
            {% endif %}
        </td>
        <td>
            {% if milestone.plannedStartDate %}
                {{ milestone.plannedStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            {% if milestone.actualStartDate %}
                {{ milestone.actualStartDate|date('d/m/Y') }}
            {% else %}
                <span class="text-muted">-</span>
            {% endif %}
        </td>
        <td>
            <span class="badge bg-secondary">{{ milestone.tasks|length }} {{ 'milestone.tasks' | trans }}</span>
        </td>
        {% if app.user %}
        <td>
            <a href="{{ path('app_crud_milestone_edit', {'id': milestone.id}) }}">{{ 'milestone.edit' | trans }}</a>
        </td>
        <td>
            {{ include('crud_milestone/_delete_form.html.twig') }}
        </td>
        {% endif %}
    </tr>
{% endfor %}
</tbody>
