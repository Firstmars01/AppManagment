<!-- Tasks -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">{{ 'task.title' | trans }} ({{ project.tasks|length }})</h5>
    </div>
    <div class="card-body">
        {% if project.tasks is empty %}
            <p class="text-muted">{{ 'task.no_tasks' | trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover">

                    {% include 'components/organisms/molecule/tasks_head.html.twig' with {'project':project}%}

                    {% include 'components/organisms/molecule/tasks_body.html.twig' with {'project':project}%}

                </table>
            </div>
        {% endif %}
    </div>
</div>
