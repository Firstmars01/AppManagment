<div class="container mt-5">
    <div class="table-responsive">
        <h2>{{ 'dashboard.my_tasks' | trans }}</h2>
        {% if tasks is empty %}
            <p>{{ 'dashboard.no_data' | trans }}</p>
        {% else %}
            <table class="table table-hover">
                {% include 'components/organisms/molecule/tasks_head_dashboard.html.twig' %}
                {% include 'components/organisms/molecule/tasks_body_dashboard.html.twig' with {'tasks': tasks} %}
            </table>
        {% endif %}
    </div>
</div>
