<div class="container mt-5">
    <div class="table-responsive">
        <h2>{{ 'dashboard.my_project' | trans }}</h2>
        {% if projects is empty %}
            <p>{{ 'dashboard.no_data' | trans }}</p>
        {% else %}
            <table class="table table-hover">
                {% include 'components/organisms/molecule/project_head.html.twig' %}
                {% include 'components/organisms/molecule/project_body.html.twig' with {'projects': projects} %}
            </table>
        {% endif %}
    </div>
</div>
