{# Milestone #}
<div class="table-responsive">
    <h2>Milestone link</h2>
    {% if task.milestone %}
        <table class="table table-hover">
            {% include 'components/organisms/molecule/milestones_head.html.twig' %}

            {% set contextData = {'milestones': [task.milestone], 'slug': project.slug} %}
            {% include 'components/organisms/molecule/milestones_body.html.twig' with {'project': contextData} %}
        </table>
    {% else %}
        <p class="text-muted">{{ 'no_milestone' | trans }}</p>
    {% endif %}
</div>