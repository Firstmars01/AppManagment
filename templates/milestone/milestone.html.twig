{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - {{ milestone.label }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {#Navigation #}
        <p>
            <a href="{{ path('project_list') }}">{{ 'breadcrumb.projects' | trans }}</a> /
            <a href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a> /
            {{ milestone.label }}
        </p>

        {# Milestone information#}
        {% include 'components/organisms/milestones_info.html.twig' with {'milestone': milestone} %}

        {# Tasks links #}
        {% include 'components/organisms/milestones_task.html.twig' with {'milestone': milestone, 'project': project} %}

    </div>
{% endblock %}
