{% extends 'base.html.twig' %}

{% block title %}{{ milestone.label }} - {{ project.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {#affiche les autre milestone #}
        <p><a href="{{ path('project_list') }}">Projets</a> / <a href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a> / {{ milestone.label }}</p>

        {# En-tête du milestone #}
        <div class="mb-4">
            <h1>{{ milestone.label }}</h1>
            {% if milestone.PlannedStartDate %}
                <p><strong>Planned Start Date :</strong> {{ milestone.PlannedStartDate|date('d/m/Y') }}</p>
            {% endif %}
            {% if milestone.ActualStartDate %}
                <p><strong>Actual Start Date :</strong> {{ milestone.ActualStartDate|date('d/m/Y') }}</p>
            {% endif %}
            {% if milestone.manager %}
                <p><strong>Responsable :</strong> {{ milestone.manager.name }} {{ milestone.manager.secondName }}</p>
            {% endif %}
        </div>
        {# Liste des tasks #}
        <div class="table-responsive">
            <table class="table table-hover">

                {% include 'components/organisms/molecule/tasks_head.html.twig' with {'project': project} %}

                {# Créer un objet qui combine project.requirements et milestone.tasks #}
                {% set contextData = {'tasks': milestone.tasks, 'requirements': project.requirements} %}
                {% include 'components/organisms/molecule/tasks_body.html.twig' with {'project': contextData} %}

            </table>
        </div>

    </div>
{% endblock %}