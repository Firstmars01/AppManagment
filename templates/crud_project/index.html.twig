{% extends 'base.html.twig' %}

{% block title %}Project index{% endblock %}

{% block body %}
    <h1>Project</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Owner</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.name }}</td>
                <td>{{ project.owner.name }} {{ project.owner.secondName }}</td>
                <td>
                    <a href="{{ path('app_crud_project_edit', {'id': project.id}) }}">edit</a>
                </td>
                <td>
                    {{ include('crud_project/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
