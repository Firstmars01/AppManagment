{% extends 'base.html.twig' %}

{% block title %}{{ 'project.index_title' | trans }}{% endblock %}

{% block body %}
    <h1>{{ 'project.title' | trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'project.name' | trans }}</th>
            <th>{{ 'project.owner' | trans }}</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.name }}</td>
                <td>{{ project.owner.name }} {{ project.owner.secondName }}</td>
                <td>
                    <a href="{{ path('app_crud_project_edit', {'id': project.id}) }}">{{ 'project.edit' | trans }}</a>
                </td>
                <td>
                    {{ include('crud_project/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{ 'project.no_records' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
