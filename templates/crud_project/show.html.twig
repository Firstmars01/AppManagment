{% extends 'base.html.twig' %}

{% block title %}{{ 'project.title' | trans }}{% endblock %}

{% block body %}
    <h1>{{ 'project.title' | trans }}</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>{{ 'project.name' | trans }}</th>
            <td>{{ project.name }}</td>
        </tr>
        <tr>
            <th>{{ 'project.owner' | trans }}</th>
            <td>{{ project.owner.name }} {{ project.owner.secondName }}</td>
        </tr>
        <tr>
            <th>{{ 'project.created_at' | trans }}</th>
            <td>{{ project.createdAt ? project.createdAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>{{ 'project.updated_at' | trans }}</th>
            <td>{{ project.updatedAt ? project.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_crud_project_index') }}">{{ 'project.back_to_list' | trans }}</a>
    <a href="{{ path('app_crud_project_edit', {'id': project.id}) }}">{{ 'project.edit' | trans }}</a>

    {{ include('crud_project/_delete_form.html.twig') }}
{% endblock %}
