<form method="post" action="{{ path('app_crud_project_delete', {'id': project.id}) }}" onsubmit="return confirm('{{ 'project.delete_confirm' | trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
    <button class="btn">{{ 'project.delete' | trans }}</button>
</form>
