{% extends 'base.html.twig' %}

{% block title %}{{ task.label }} - {{ project.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {# Navigation #}
        <p><a href="{{ path('project_list') }}">Projets</a> / <a
                    href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a> / {{ task.label }}
        </p>

        {# Task Information #}
        {% include 'components/organisms/tasks_info.html.twig' with {'task': task} %}

        {# Task Requirement #}
        {% include 'components/organisms/tasks_requirement.html.twig' with {'task': task, 'project': project} %}

        {# Milestone #}
        {% include 'components/organisms/tasks_milestone.html.twig' with {'task': task, 'project': project} %}

    </div>
{% endblock %}