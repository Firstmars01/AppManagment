{% extends 'base.html.twig' %}

{% block title %}{{ task.label }} - {{ project.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {#Navigation #}
        <p><a href="{{ path('project_list') }}">Projets</a> / <a href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a> / {{ task.label }}</p>

        {# Tasks information#}
        <div class="mb-4">

            <h1>{{ task.label }}</h1>

            <p>
                <strong>Description :</strong> {{ task.description ?? 'Aucune description' }}
            </p>

            <p>
                <strong>Manager :</strong>
                {{ task.manager.name }} {{ task.manager.secondName }}
            </p>

            <p>
                <strong>Planned start :</strong>
                {% if task.plannedStartDate %}
                    {{ task.plannedStartDate|date('d/m/Y') }}
                {% else %}
                    <span class="text-muted">-</span>
                {% endif %}
            </p>

            <p>
                <strong>Actual start :</strong>
                {% if task.actualStartDate %}
                    {{ task.actualStartDate|date('d/m/Y') }}
                {% else %}
                    <span class="text-muted">-</span>
                {% endif %}
            </p>

            <p>
                <strong>Estimated days :</strong>
                {% if task.daysEstimate %}
                    {{ task.daysEstimate }} days
                {% else %}
                    <span class="text-muted">-</span>
                {% endif %}
            </p>

            <p>
                <strong>Functional :</strong>
                {% if task.isFunctional %}
                    <span class="badge bg-success">Yes</span>
                {% else %}
                    <span class="badge bg-danger">No</span>
                {% endif %}
            </p>

        </div>

        {# Requirement information #}
        <div class="table-responsive">
            <h2>Requirements link</h2>
            {% if task.requirements is empty %}
                <p class="text-muted">No requirement linked to this task.</p>
            {% else %}
                <table class="table table-hover">
                    {% include 'components/organisms/molecule/requirements_head.html.twig' %}

                    {% set contextData = {'requirements': task.requirements, 'slug': project.slug} %}
                    {% include 'components/organisms/molecule/requirements_body.html.twig' with {'project': contextData} %}
                </table>
            {% endif %}
        </div>

        {# Milestone information #}
        <div class="table-responsive">
            <h2>Milestone link</h2>
            {% if task.milestone %}
                <table class="table table-hover">
                    {% include 'components/organisms/molecule/milestones_head.html.twig' %}

                    {% set contextData = {'milestones': [task.milestone], 'slug': project.slug} %}
                    {% include 'components/organisms/molecule/milestones_body.html.twig' with {'project': contextData} %}
                </table>
            {% else %}
                <p class="text-muted">No milestone linked to this task.</p>
            {% endif %}
        </div>

    </div>
{% endblock %}