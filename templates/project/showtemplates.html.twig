{% extends 'base.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <!-- Project Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>{{ project.name }}</h1>
            <a href="{{ path('project_list') }}" class="btn btn-secondary">
                Back to list
            </a>
        </div>

        <!-- General Information -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">General Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Owner:</strong> {{ project.owner.name }} {{ project.owner.secondName }}</p>
                        <p><strong>Email:</strong> {{ project.owner.email }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Created on:</strong> {{ project.createdAt|date('d/m/Y at H:i') }}</p>
                        <p><strong>Last updated:</strong> {{ project.updatedAt|date('d/m/Y at H:i') }}</p>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="badge bg-primary fs-6">{{ project.tasks|length }} tasks</span>
                    <span class="badge bg-info fs-6 ms-2">{{ project.requirements|length }} requirements</span>
                    <span class="badge bg-success fs-6 ms-2">{{ project.milestones|length }} milestones</span>
                </div>
            </div>
        </div>

        <!-- Milestones -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Milestones ({{ project.milestones|length }})</h5>
            </div>
            <div class="card-body">
                {% if project.milestones is empty %}
                    <p class="text-muted">No milestone defined for this project.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Label</th>
                                <th>Manager</th>
                                <th>Planned Start Date</th>
                                <th>Actual Start Date</th>
                                <th>Tasks</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for milestone in project.milestones %}
                                <tr>
                                    <td><strong>{{ milestone.label }}</strong></td>
                                    <td>
                                        {% if milestone.manager %}
                                            {{ milestone.manager.name }} {{ milestone.manager.secondName }}
                                        {% else %}
                                            <span class="text-muted">Unassigned</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if milestone.plannedStartDate %}
                                            {{ milestone.plannedStartDate|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if milestone.actualStartDate %}
                                            {{ milestone.actualStartDate|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ milestone.tasks|length }} tasks</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Requirements -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Requirements ({{ project.requirements|length }})</h5>
            </div>
            <div class="card-body">
                {% if project.requirements is empty %}
                    <p class="text-muted">No requirement defined for this project.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th style="width: 50%">Description</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Linked Tasks</th>
                                <th>Created on</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for requirement in project.requirements %}
                                <tr>
                                    <td>{{ requirement.description }}</td>
                                    <td>
                                        {% if requirement.isFunctional %}
                                            <span class="badge bg-success">Functional</span>
                                        {% else %}
                                            <span class="badge bg-warning">Non-functional</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ requirement.requirementType.label }}</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">{{ requirement.tasks|length }}</span>
                                    </td>
                                    <td>{{ requirement.createdAt|date('d/m/Y') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Tasks -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Tasks ({{ project.tasks|length }})</h5>
            </div>
            <div class="card-body">
                {% if project.tasks is empty %}
                    <p class="text-muted">No task defined for this project.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Label</th>
                                <th>Milestone</th>
                                <th>Manager</th>
                                <th>Type</th>
                                <th>Planned Start Date</th>
                                <th>Actual Start Date</th>
                                <th>Estimated Duration</th>
                                <th>Requirements</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for task in project.tasks %}
                                <tr>
                                    <td><strong>{{ task.label }}</strong></td>
                                    <td>{{ task.milestone.label }}</td>
                                    <td>{{ task.manager.name }} {{ task.manager.secondName }}</td>
                                    <td>
                                        {% if task.isFunctional %}
                                            <span class="badge bg-success">Functional</span>
                                        {% else %}
                                            <span class="badge bg-warning">Technical</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.plannedStartDate %}
                                            {{ task.plannedStartDate|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.actualStartDate %}
                                            {{ task.actualStartDate|date('d/m/Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.daysEstimate %}
                                            {{ task.daysEstimate }} days
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ task.requirements|length }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
