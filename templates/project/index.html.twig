{% extends 'base.html.twig' %}

{% block title %}Projet list{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Projet list</h1>

        {% if projects is empty %}
            <p>No data</p>
        {% else %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Owner</th>
                    <th>Creation date</th>
                </tr>
                </thead>
                <tbody>
                {% for project in projects %}
                    <tr>
                        <td>{{ project.name }} | </td>
                        <td>{{ project.owner.name }} {{ project.owner.secondName }} | </td>
                        <td>{{ project.createdAt|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}