<form method="post" action="{{ path('app_crud_requirement_delete', {'id': requirement.id}) }}" onsubmit="return confirm('{{ 'requirement.delete_confirm' | trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ requirement.id) }}">
    <button class="btn">{{ 'requirement.delete' | trans }}</button>
</form>
