{% extends 'base.html.twig' %}

{% block title %}{{ requirement.name }} - {{ project.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {# Breadcrumb #}
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('project_list') }}">Projets</a></li>
                <li class="breadcrumb-item"><a href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_milestone', { slug: project.slug, id: milestone.id }) }}">{{ milestone.name }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ requirement.name }}</li>
            </ol>
        </nav>

        {# En-tête du requirement #}
        <div class="mb-4">
            <h1>{{ requirement.name }}</h1>
            {% if requirement.description %}
                <p class="text-muted">{{ requirement.description }}</p>
            {% endif %}
            {% if requirement.status %}
                <p><span class="badge bg-{{ requirement.status == 'completed' ? 'success' : 'warning' }}">{{ requirement.status }}</span></p>
            {% endif %}
        </div>

        {# Liste des tasks #}
        <div class="card">
            <div class="card-header">
                <h2 class="h4 mb-0">Tasks</h2>
            </div>
            <div class="card-body">
                {% if requirement.tasks is empty %}
                    <p class="text-muted">Aucune task pour ce requirement</p>
                {% else %}
                    <div class="list-group">
                        {% for task in requirement.tasks %}
                            <a href="{{ path('app_task', {
                                slug: project.slug,
                                milestoneId: milestone.id,
                                requirementId: requirement.id,
                                id: task.id
                            }) }}" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-1">{{ task.name }}</h5>
                                    {% if task.status %}
                                        <span class="badge bg-{{ task.status == 'completed' ? 'success' : (task.status == 'in_progress' ? 'primary' : 'secondary') }}">
                                        {{ task.status }}
                                    </span>
                                    {% endif %}
                                </div>
                                {% if task.description %}
                                    <p class="mb-1">{{ task.description|slice(0, 100) }}...</p>
                                {% endif %}
                                {% if task.assignedTo %}
                                    <small class="text-muted">Assigné à : {{ task.assignedTo.name }}</small>
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}