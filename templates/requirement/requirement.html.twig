{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - {{ 'breadcrumb.requirement' | trans }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        {#Navigation #}
        <p>
            <a href="{{ path('project_list') }}">{{ 'breadcrumb.projects' | trans }}</a> /
            <a href="{{ path('project_show', { slug: project.slug }) }}">{{ project.name }}</a> /
            {{ requirement.description }}
        </p>

        {# Requirement information #}
        {% include 'components/organisms/requirements_info.html.twig' with {'requirement': requirement} %}

        {# Tasks links #}
        {% include 'components/organisms/requirements_task.html.twig' with {'requirement': requirement, 'project': project} %}

    </div>
{% endblock %}
