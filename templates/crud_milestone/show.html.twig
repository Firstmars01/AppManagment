{% extends 'base.html.twig' %}

{% block title %}Milestone{% endblock %}

{% block body %}
    <h1>Milestone</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ milestone.id }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ milestone.label }}</td>
            </tr>
            <tr>
                <th>PlannedStartDate</th>
                <td>{{ milestone.plannedStartDate ? milestone.plannedStartDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>ActualStartDate</th>
                <td>{{ milestone.actualStartDate ? milestone.actualStartDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_crud_milestone_index') }}">back to list</a>

    <a href="{{ path('app_crud_milestone_edit', {'id': milestone.id}) }}">edit</a>

    {{ include('crud_milestone/_delete_form.html.twig') }}
{% endblock %}
