{% extends 'base.html.twig' %}

{% block title %}Milestone index{% endblock %}

{% block body %}
    <h1>Milestone</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Label</th>

            </tr>
        </thead>
        <tbody>
        {% for milestone in milestones %}
            <tr>
                <td>{{ milestone.label }}</td>
                <td>
                    <a href="{{ path('app_crud_milestone_show', {'id': milestone.id}) }}">show</a>
                    <a href="{{ path('app_crud_milestone_edit', {'id': milestone.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
