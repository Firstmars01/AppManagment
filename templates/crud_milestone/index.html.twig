{% extends 'base.html.twig' %}

{% block title %}{{ 'milestone.index_title' | trans }}{% endblock %}

{% block body %}
    <h1>{{ 'milestone.title' | trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'milestone.label' | trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for milestone in milestones %}
            <tr>
                <td>{{ milestone.label }}</td>
                <td>
                    <a href="{{ path('app_crud_milestone_show', {'id': milestone.id}) }}">{{ 'milestone.show' | trans }}</a>
                    <a href="{{ path('app_crud_milestone_edit', {'id': milestone.id}) }}">{{ 'milestone.edit' | trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">{{ 'milestone.no_records' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
