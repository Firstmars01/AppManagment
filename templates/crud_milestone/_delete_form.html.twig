<form method="post" action="{{ path('app_crud_milestone_delete', {'id': milestone.id}) }}" onsubmit="return confirm('{{ 'milestone.delete_confirm' | trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ milestone.id) }}">
    <button class="btn">{{ 'milestone.delete' | trans }}</button>
</form>
