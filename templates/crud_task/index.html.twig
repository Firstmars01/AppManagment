{% extends 'base.html.twig' %}

{% block title %}{{ 'task.index_title' | trans }}{% endblock %}

{% block body %}
    <h1>{{ 'task.title' | trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'task.label' | trans }}</th>
            <th>{{ 'task.description' | trans }}</th>
            <th>{{ 'task.status' | trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for task in tasks %}
            <tr>
                <td>{{ task.label }}</td>
                <td>{{ task.description }}</td>
                <td>
                    <a href="{{ path('app_crud_task_show', {'id': task.id}) }}">{{ 'task.show' | trans }}</a>
                    <a href="{{ path('app_crud_task_edit', {'id': task.id}) }}">{{ 'task.edit' | trans }}</a>
                </td>
                <td>
                    {{ include('crud_task/_delete_form.html.twig') }}
                </td>
                <td>


                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">{{ 'task.no_records' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
