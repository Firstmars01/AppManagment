{% extends 'base.html.twig' %}

{% block title %}Task index{% endblock %}

{% block body %}
    <h1>Task index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>IsFunctional</th>
                <th>Label</th>
                <th>PlannedStartDate</th>
                <th>ActualStartDate</th>
                <th>DaysEstimate</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for task in tasks %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.isFunctional ? 'Yes' : 'No' }}</td>
                <td>{{ task.label }}</td>
                <td>{{ task.plannedStartDate ? task.plannedStartDate|date('Y-m-d') : '' }}</td>
                <td>{{ task.actualStartDate ? task.actualStartDate|date('Y-m-d') : '' }}</td>
                <td>{{ task.daysEstimate }}</td>
                <td>{{ task.description }}</td>
                <td>
                    <a href="{{ path('app_crud_task_show', {'id': task.id}) }}">show</a>
                    <a href="{{ path('app_crud_task_edit', {'id': task.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_crud_task_new') }}">Create new</a>
{% endblock %}
