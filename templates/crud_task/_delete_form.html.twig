<form method="post" action="{{ path('app_crud_task_delete', {'id': task.id}) }}" onsubmit="return confirm('{{ 'task.delete_confirm' | trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
    <button class="btn">{{ 'task.delete' | trans }}</button>
</form>
